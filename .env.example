# ---------------------------------------------------------------------------------------------
# NestIn server configuration (copy to .env). All values are optional in development.
# ---------------------------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Set to "true" when running behind a reverse proxy / load balancer (uses X-Forwarded-For for rate limits & sessions).
TRUST_PROXY=false

# Persistence — SQLite database file (created automatically). Use a mounted volume in Docker.
DATABASE_PATH=./data/nestin.db
# Seed the demo owner/tenant/staff workspace and marketplace catalogue on first start.
# Default: true in development, FALSE in production (must be set to "true" explicitly, and then DEMO_PASSWORD must not be the default).
SEED_DEMO_DATA=true
# Password for the demo accounts (owner@nestin.com, tenant@nestin.com, staff@nestin.com) when SEED_DEMO_DATA=true.
DEMO_PASSWORD=NestIn@2026

# Security — REQUIRED in production (>= 32 random characters). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Session lifetime in seconds (default 7 days).
JWT_TTL_SECONDS=604800
# Extra browser origins allowed to call the API (comma separated). Same-origin is always allowed.
CORS_ORIGINS=

# Super administrator (admin console at /admin/login). Required in production.
SUPER_ADMIN_EMAIL=admin@nestin.io
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_ACCESS_CODE=

# Google Sign-In (Google Identity Services). Both values are the same OAuth 2.0 Web client ID.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Payments (Razorpay). In development, missing keys mean online payments are *simulated*.
# In production the server refuses to start without keys unless ALLOW_SIMULATED_PAYMENTS=true (staging only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_SIMULATED_PAYMENTS=false

# Abuse protection
AUTH_MAX_ATTEMPTS=20
API_MAX_REQUESTS_PER_MINUTE=600

# ---------------------------------------------------------------------------------------------
# Integrations (all optional — features degrade gracefully when unset)
# ---------------------------------------------------------------------------------------------

# Production domain used by docker-compose.prod.yml (Caddy issues the TLS certificate automatically).
DOMAIN=

# File storage: "local" keeps uploads next to the database; "s3" works with AWS S3, Cloudflare R2, MinIO.
STORAGE_DRIVER=local
UPLOADS_DIR=
MAX_UPLOAD_MB=10
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN/base URL for listing photos & avatars (e.g. https://cdn.example.com). Private KYC files always use signed URLs.
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Email: resend | sendgrid | log (default). "log" records messages in the admin Outbox without sending.
EMAIL_PROVIDER=
EMAIL_FROM=NestIn <no-reply@example.com>
RESEND_API_KEY=
SENDGRID_API_KEY=

# WhatsApp via Twilio (sandbox or approved sender), e.g. TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Scheduled jobs: rent reminders go out once per month after this day (1-28). DISABLE_JOBS=true turns the scheduler off.
RENT_DUE_DAY=5
DISABLE_JOBS=false

# ---------------------------------------------------------------------------------------------
# Business model
# ---------------------------------------------------------------------------------------------

# Percentage retained by the platform on rent/deposits collected online (0 = no fee; max 20).
PLATFORM_FEE_PERCENT=0
# Days of Professional plan every new owner gets before falling back to Starter (0 = no trial).
PLAN_TRIAL_DAYS=14
# GST applied to subscription invoices.
SUBSCRIPTION_GST_PERCENT=18
# Months a "NestIn Verified" badge stays valid before a re-verification visit is required.
VERIFICATION_VALIDITY_MONTHS=12

# ---------------------------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------------------------

# Nightly SQLite snapshots (VACUUM INTO). Mirrored to S3 under BACKUP_S3_PREFIX when STORAGE_DRIVER=s3.
DISABLE_BACKUPS=false
BACKUP_DIR=
BACKUP_KEEP=14
BACKUP_S3_PREFIX=backups/

# Structured logs: json (production default) | pretty (development default) | off
LOG_FORMAT=
# Bearer token Prometheus must send to scrape /metrics (REQUIRED in production — the server refuses to start without it).
METRICS_TOKEN=

# Web Push (VAPID). Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
