# ---------------------------------------------------------------------------------------------
# NestIn server configuration (copy to .env). All values are optional in development.
# ---------------------------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Set to "true" when running behind a reverse proxy / load balancer (uses X-Forwarded-For for rate limits & sessions).
TRUST_PROXY=false

# Persistence — SQLite database file (created automatically). Use a mounted volume in Docker.
DATABASE_PATH=./data/nestin.db
# Seed the demo owner/tenant/staff workspace and marketplace catalogue on first start (set to false for a clean production DB).
SEED_DEMO_DATA=true
# Password for the demo accounts (owner@nestin.com, tenant@nestin.com, staff@nestin.com) when SEED_DEMO_DATA=true.
DEMO_PASSWORD=NestIn@2026

# Security — REQUIRED in production (>= 32 random characters). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Session lifetime in seconds (default 7 days).
JWT_TTL_SECONDS=604800
# Extra browser origins allowed to call the API (comma separated). Same-origin is always allowed.
CORS_ORIGINS=

# Super administrator (admin console at /admin/login). Required in production.
SUPER_ADMIN_EMAIL=admin@nestin.io
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_ACCESS_CODE=

# Google Sign-In (Google Identity Services). Both values are the same OAuth 2.0 Web client ID.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Payments (Razorpay) — when unset, online payments are recorded as simulated successes.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Abuse protection
AUTH_MAX_ATTEMPTS=20
API_MAX_REQUESTS_PER_MINUTE=600
