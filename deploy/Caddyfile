# Reverse proxy with automatic HTTPS (Let's Encrypt). Set DOMAIN in .env, e.g. DOMAIN=nestin.example.com
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy nestin:3000
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	request_body {
		max_size 12MB
	}
}
