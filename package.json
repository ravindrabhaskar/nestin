{
  "name": "nestin",
  "private": true,
  "version": "3.1.0",
  "description": "NestIn — verified PG & co-living marketplace with owner CRM, staff RBAC and tenant portal.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./src/** --ignore ./data/** server.ts",
    "build": "node scripts/build-client.mjs && node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "node -e \"for (const d of ['dist','data']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:api",
    "test:api": "node --import tsx --test \"tests/api/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm run test:api && npm run test:e2e",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"scripts/*.mjs\" eslint.config.js public/sw.js",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"scripts/*.mjs\" eslint.config.js public/sw.js",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1133.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "compression": "^1.7.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.25",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.84.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0"
  }
}
