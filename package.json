{
  "name": "nestin",
  "private": true,
  "version": "3.0.0",
  "description": "NestIn — verified PG & co-living marketplace with owner CRM, staff RBAC and tenant portal.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./src/** --ignore ./data/** server.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "node -e \"for (const d of ['dist','data']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "npm run test:api",
    "test:api": "node --import tsx --test \"tests/api/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "compression": "^1.7.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.25",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.84.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
